@model RequestItem

@{
    ViewData["Title"] = "Request Details";
}

<div class="details-card">

    <div class="d-flex justify-content-between align-items-start">

        <div>
            <h5 class="fw-bold">
                @Model.RequestNo · @Model.Title
            </h5>

            <span class="status-badge @Model.Status.ToString().ToLowerInvariant()">
                @Model.Status
            </span>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ပိတ်ရန်
        </a>

    </div>

    <p class="mt-3">@Model.Description</p>

    <div class="row g-4 mt-2">

        <div class="col-md-4">
            <label>Project / Priority</label>
            <p>@Model.Project / @Model.Priority</p>
        </div>

        <div class="col-md-4">
            <label>Requester / တင်သွင်းသူ</label>
            <p>
                @Model.Requester
                <br />
                @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm:ss")
            </p>
        </div>

        <div class="col-md-4">
            <label>တာဝန်ယူသူ</label>
            <p>
                @(Model.Assignee ?? "Unassigned")
                <br />
                @(Model.AssignedAt?.ToString("dd MMM yyyy, HH:mm:ss") ?? "—")
            </p>
        </div>

        <div class="col-md-4">
            <label>ပြီးစီးရမည့်ရက်</label>
            <p>@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "—")</p>
        </div>

        <div class="col-md-4">
            <label>ပြီးဆုံးချိန်</label>
            <p>@(Model.CompletedAt?.ToString("dd MMM yyyy, HH:mm:ss") ?? "—")</p>
        </div>

    </div>

    <hr />

    <!-- ASSIGN / REASSIGN -->

    <form asp-action="Assign" method="post">

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Assign / Reassign
                </label>

                <select name="assignee" class="form-select" required>

                    <option value="">Select developer</option>

                    @foreach (var developer in (string[])ViewBag.Developers)
                    {
                        <option value="@developer"
                                selected="@(Model.Assignee == developer)">
                            @developer
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-6">

                <label class="form-label">
                    မှတ်ချက်
                </label>

                <textarea name="note"
                          class="form-control"
                          rows="2"
                          placeholder="Enter note..."></textarea>

            </div>

        </div>

        <div class="action-buttons mt-3">

            <button type="submit" class="btn btn-outline-secondary">
                Reassign
            </button>

        </div>

    </form>

    <!-- STATUS BUTTONS -->

    <div class="action-buttons mt-3">

        @if (Model.Status != RequestStatus.Completed &&
             Model.Status != RequestStatus.Cancelled)
        {
            <form asp-action="ChangeStatus" method="post">

                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="OnHold" />

                <button type="submit" class="btn btn-outline-secondary">
                    On hold
                </button>

            </form>

            @if (Model.Assignee != null)
            {
                <form asp-action="ChangeStatus" method="post">

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="Completed" />

                    <button type="submit" class="btn btn-primary">
                        Mark completed
                    </button>

                </form>
            }

            <form asp-action="ChangeStatus" method="post">

                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Cancelled" />

                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Cancel this request?')">
                    Cancel request
                </button>

            </form>
        }

        @if (Model.Status == RequestStatus.Completed ||
             Model.Status == RequestStatus.Cancelled)
        {
            <form asp-action="ChangeStatus" method="post">

                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="Submitted" />

                <button type="submit" class="btn btn-primary">
                    Reopen Request
                </button>

            </form>
        }

    </div>

    <hr />

    <!-- ACTIVITY HISTORY -->

    <h5 class="fw-bold mb-4">
        Activity history
    </h5>

    <ol class="activity-list">

        @foreach (var activity in Model.Activities.OrderBy(x => x.CreatedAt))
        {
            <li>

                <div>
                    <strong>@activity.Actor</strong>
                    <span>@activity.Action</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(activity.Note))
                {
                    <p class="text-secondary mb-1">
                        @activity.Note
                    </p>
                }

                <small>
                    @activity.CreatedAt.ToString("dd MMM yyyy, HH:mm:ss")
                </small>

            </li>
        }

    </ol>

</div>

