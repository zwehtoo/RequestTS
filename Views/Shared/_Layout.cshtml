
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - RequestTrack</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="app-header">

        <div class="header-top">

            <div>
                <h4>
                    RequestTrack
                    <span class="sample-tag">Live Database</span>
                </h4>

                <small>Project requests & work tracking</small>
            </div>

            <div class="manager-info">
                <div>Request Management</div>
                <small>Myanmar time · UTC+06:30</small>
            </div>

        </div>

        <nav class="app-nav">

            <a asp-controller="Requests"
               asp-action="Index"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Requests" ? "active" : "")">
                Requests
            </a>

            <a asp-controller="Requests"
               asp-action="Create"
               class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                + Request တင်ရန်
            </a>

            <a asp-controller="Reports"
               asp-action="Index"
               class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                Reports
            </a>

        </nav>

    </header>

    <main class="app-content">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @RenderBody()

    </main>

    <footer class="app-footer">
        Copyright ဘာညာ
        <br />
        RequestTrack · ASP.NET Core MVC · .NET 10 by Zwe Zarni Htoo
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
