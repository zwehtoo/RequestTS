@model RequestFilterViewModel

@{
    ViewData["Title"] = "Requests";
}

<div class="page-heading d-flex justify-content-between align-items-center">

    <div>
        <h3>Request စာရင်း</h3>
        <p>Request No. ကို နှိပ်ပြီး Assign, Status နှင့် History ကြည့်နိုင်ပါသည်။</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + New request
    </a>

</div>

<form method="get" asp-action="Index" class="filter-row">

    <div>
        <label>Project</label>

        <select name="project" class="form-select">
            <option value="">အားလုံး</option>

            <option value="TradeNet Portal"
                    selected="@(Model.Project == "TradeNet Portal")">
                TradeNet Portal
            </option>

            <option value="Mobile App"
                    selected="@(Model.Project == "Mobile App")">
                Mobile App
            </option>

            <option value="Internal Operations"
                    selected="@(Model.Project == "Internal Operations")">
                Internal Operations
            </option>
        </select>
    </div>

    <div>
        <label>Status</label>

        <select name="status" class="form-select">
            <option value="">အားလုံး</option>

            @foreach (RequestStatus s in Enum.GetValues<RequestStatus>())
            {
                <option value="@s"
                        selected="@(Model.Status == s.ToString())">
                    @s
                </option>
            }
        </select>
    </div>

    <div>
        <label>လက်ရှိတာဝန်ယူသူ</label>

        <select name="assignee" class="form-select">
            <option value="">အားလုံး</option>

            <option value="Unassigned"
                    selected="@(Model.Assignee == "Unassigned")">
                Unassigned
            </option>

            @foreach (var developer in SampleData.Developers)
            {
                <option value="@developer"
                        selected="@(Model.Assignee == developer)">
                    @developer
                </option>
            }
        </select>
    </div>

    <div class="filter-actions">
        <button type="submit" class="btn btn-primary">
            Filter
        </button>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Reset
        </a>
    </div>

</form>

<div class="table-responsive request-table-wrapper">

    <table class="table request-table">

        <thead>
            <tr>
                <th>Request / Project</th>
                <th>အကြောင်းအရာ</th>
                <th>Status</th>
                <th>တာဝန်ယူသူ</th>
                <th>တင်သွင်းချိန်</th>
                <th>ပြီးဆုံးချိန်</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.Requests)
            {
                <tr>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="request-link">
                            @item.RequestNo
                        </a>

                        <small class="d-block text-secondary">
                            @item.Project
                        </small>
                    </td>

                    <td>@item.Title</td>

                    <td>
                        <span class="status-badge @item.Status.ToString().ToLowerInvariant()">
                            @item.Status
                        </span>
                    </td>

                    <td>@(item.Assignee ?? "Unassigned")</td>

                    <td>
                        @item.CreatedAt.ToString("dd MMM yyyy, HH:mm:ss")
                    </td>

                    <td>
                        @(item.CompletedAt?.ToString("dd MMM yyyy, HH:mm:ss") ?? "—")
                    </td>

                </tr>
            }

            @if (!Model.Requests.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-secondary p-4">
                        No requests found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

<p class="text-secondary small mt-2">
    @Model.Requests.Count requests
</p>
