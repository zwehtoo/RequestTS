@model CreateRequestViewModel

@{
    ViewData["Title"] = "Create Request";
}

<div class="page-heading">

    <h3>Request အသစ် တင်ရန်</h3>

    <p>
        ပြဿနာများ၊ ပြင်ဆင်မှုများ · Requester: May Thu
    </p>

</div>

<div class="details-card">

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-3">

            <div class="col-md-6">

                <label asp-for="Project" class="form-label">
                    Project *
                </label>

                <select asp-for="Project" class="form-select">
                    <option value="">Select Project</option>
                    <option>TradeNet Portal</option>
                    <option>Mobile App</option>
                    <option>Internal Operations</option>
                </select>

                <span asp-validation-for="Project"
                      class="text-danger"></span>

            </div>

            <div class="col-md-6">

                <label asp-for="Priority" class="form-label">
                    Priority *
                </label>

                <select asp-for="Priority" class="form-select">
                    <option>High</option>
                    <option>Normal</option>
                    <option>Low</option>
                </select>

                <span asp-validation-for="Priority"
                      class="text-danger"></span>

            </div>

            <div class="col-12">

                <label asp-for="Title" class="form-label">
                    အကြောင်းအရာ / Title *
                </label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter request title" />

                <span asp-validation-for="Title"
                      class="text-danger"></span>

            </div>

            <div class="col-12">

                <label asp-for="Description" class="form-label">
                    အသေးစိတ်ဖော်ပြချက် *
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Describe your request..."></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>

            </div>

            <div class="col-md-6">

                <label asp-for="DueDate" class="form-label">
                    ပြီးစီးရမည့်ရက်
                </label>

                <input asp-for="DueDate"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-6 d-flex align-items-end">

                <p class="text-secondary small">
                    Submit ပြီးပါက Status = Submitted ဖြစ်ပါမည်။
                </p>

            </div>

        </div>

        <div class="mt-4 d-flex gap-2">

            <button type="submit" class="btn btn-primary">
                Submit request
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
